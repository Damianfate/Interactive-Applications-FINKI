<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Title</title>
    <link rel="stylesheet" href="jquery/jquery-ui.css">
    <script src="jquery/jquery.js"></script>
    <script src="jquery/jquery-ui.js"></script>
</head>
<style>
    .tr-hover{
        cursor: pointer;
    }
    .row-select{
        background-color: lightblue;
    }
</style>
<body>
<div>
    <button id="delete">Delete</button>
    <button id="restore">Restore</button>
    <table>
        <tr id="0"> <td><input type="checkbox" value="0"></td><td>Sender
            1</td><td>Subject 2</td> </tr>
        <tr id="1"> <td><input type="checkbox" value="1"></td><td>Sender
            2</td><td>Subject 2</td> </tr>
        <tr id="2"> <td><input type="checkbox" value="2"></td><td>Sender
            3</td><td>Subject 3</td> </tr>
        <tr id="3"> <td><input type="checkbox" value="3"></td><td>Sender
            4</td><td>Subject 4</td> </tr>
        <tr id="4"> <td><input type="checkbox" value="4"></td><td>Sender
            5</td><td>Subject 5</td> </tr>
        <tr id="5"> <td><input type="checkbox" value="5"></td><td>Sender
            6</td><td>Subject 6</td> </tr>
        <tr id="6"> <td><input type="checkbox" value="6"></td><td>Sender
            7</td><td>Subject 7</td> </tr>
    </table>
    <script>
        $(document).ready(function (){
            $("tr").hover(function (){
                $(this).addClass("tr-hover");
            })
            $("input[type=checkbox]").click(function () {
                if ($(this).prop("checked") == true) {
                    $("#" + $(this).val()).addClass("row-select");
                } else {
                    $("#" + $(this).val()).removeClass("row-select");
                }
            });
            $("#delete").click(function (){
                if($(".row-select").length===0){
                    alert("Nmeate nisto obelezano")
                }else{
                    $(".row-select").hide();
                }
            })
            $('#restore').click(function (){
                $("tr").show();
            })
        })
    </script>
</div>
</body>
</html>
