        })
        $(".nav_el").click(function () {
            $("#compact, #dslr, #flash").hide()
            var title = $(this).attr("title")
            $("#"+title).show()
        })
        $(".data").hide()
        $(".acc_item h3").click(function () {
            $(this).siblings(".data").slideToggle(200)
        })
    })
